# Postgres (Supabase). From the Supabase dashboard: Project Settings -> Database ->
# Connection string -> "Transaction pooler" (port 6543) — pooled, so it survives Vercel's
# short-lived serverless functions without exhausting Supabase's connection limit. Required.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Base URL of this app, used to build links in transactional e-mails (password reset, etc).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage, used to store KYC documents, product images and banners. From the Supabase
# dashboard: Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security —
# server-side only, never expose it to the client.
# Optional in development: without both set, uploads fall back to ./public/uploads (dev only,
# never used in production since Vercel's filesystem isn't persistent).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket to upload into — create it in Supabase Storage as a public bucket. Defaults to
# "seu-zuca-uploads" if unset.
SUPABASE_STORAGE_BUCKET=seu-zuca-uploads

# Resend API key for transactional e-mail (account approval/rejection, password reset).
# Optional in development: without it, e-mails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Seu Zuca <no-reply@seuzuca.com.br>"
