# Postgres (Supabase). From the Supabase dashboard: Project Settings -> Database ->
# Connection string -> "Transaction pooler" (port 6543) — pooled, so it survives Vercel's
# short-lived serverless functions without exhausting Supabase's connection limit. Required.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Base URL of this app, used to build links in transactional e-mails (password reset, etc).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage, used to store KYC documents, product images and banners. From the Supabase
# dashboard: Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security —
# server-side only, never expose it to the client.
# Optional in development: without both set, uploads fall back to ./public/uploads (dev only,
# never used in production since Vercel's filesystem isn't persistent).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket to upload into — create it in Supabase Storage as a public bucket. Defaults to
# "seu-zuca-uploads" if unset.
SUPABASE_STORAGE_BUCKET=seu-zuca-uploads

# Resend API key for transactional e-mail (account approval/rejection, password reset).
# Optional in development: without it, e-mails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Seu Zuca <no-reply@seuzuca.com.br>"

# Mercado Pago (Checkout API: PIX, boleto, cartão) — from the Mercado Pago dashboard,
# Suas integrações > [sua aplicação] > Credenciais de teste (sandbox) ou produção.
# Optional in development: without it, checkout still creates orders, but skips the real payment
# call — /pagamento shows a "not configured" notice instead of a QR code/boleto/redirect.
MERCADOPAGO_ACCESS_TOKEN=
# Webhook signature secret — same dashboard page, "Configurar notificações" for this app's
# webhook URL (.../api/webhooks/mercadopago). Optional in development (validation is skipped with
# a warning), but required in production: without it, the webhook trusts any caller.
MERCADOPAGO_WEBHOOK_SECRET=

# OpenRouteService (geocoding + real route distance, SPEC.md §10, LOG-03) — free tier, sign up at
# https://openrouteservice.org/dev/#/signup (no credit card), then Dashboard > Request a token.
# Optional in development: without it, addresses are never geocoded, "raio" coverage rules never
# restrict anyone, and distance-based freight rates fall back to their minimum floor — the same
# documented fallback behavior as if the request to the provider had failed.
OPENROUTESERVICE_API_KEY=
